# Placeholders only. No live keys.
# The n8n descriptor reads none of these variables.

# Argument hmacSecret on executeSpurvikWorkflowStep. At least 16 characters.
# The helper does not send this value to the control plane.
SPURVIK_HMAC_SECRET=replace-with-at-least-16-characters

# SDK HTTP only. packages/n8n-nodes-spurvik does not read these.
SPURVIK_API_KEY=spurvik_live_REPLACE_ME
SPURVIK_REVIEWER_TOKEN=spurvik_reviewer_REPLACE_ME
SPURVIK_BASE_URL=https://example.com

# channel.webhookUrl when a direct call passes a Slack, Discord, or Teams channel.
CHANNEL_WEBHOOK_URL=https://example.com/hooks/REPLACE_ME

# callbackBaseUrl on executeSpurvikWorkflowStep.
CALLBACK_BASE_URL=https://example.com/hitl
