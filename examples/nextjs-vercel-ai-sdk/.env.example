# Replace before you send a chat message. The app does not call OpenAI while this placeholder is set.
OPENAI_API_KEY=your-key-here

# Spurvik. The chat route returns HTTP 400 while these are missing or still the placeholders below.
# SPURVIK_API_KEY is a project key. SPURVIK_SIGNING_SECRET and SPURVIK_CONTENT_HASH_SECRET
# each need at least 16 characters. The content-hash secret stays on this server.
# SPURVIK_BASE_URL is required when NODE_ENV is production.
# In development the SDK uses http://127.0.0.1:43123 when that variable is omitted.
# A Free or developer plan key may return HTTP 402 on paid-only features.
SPURVIK_API_KEY=your-key-here
SPURVIK_SIGNING_SECRET=your-secret-here
SPURVIK_CONTENT_HASH_SECRET=your-secret-here
SPURVIK_BASE_URL=your-url-here
