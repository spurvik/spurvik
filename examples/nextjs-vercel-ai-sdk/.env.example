# Replace before you send a chat message. The app does not call OpenAI while this placeholder is set.
OPENAI_API_KEY=your-key-here

# Spurvik. The placeholders below are treated as unset.
# Unset values use a local development path: format-only placeholders and the SDK
# development base URL http://127.0.0.1:43123. No live project key is required.
# Telemetry is not delivered when that address is down. The model call still runs.
# A Free or developer plan key may return HTTP 402 on paid-only features.
SPURVIK_API_KEY=your-key-here
SPURVIK_SIGNING_SECRET=your-secret-here
SPURVIK_CONTENT_HASH_SECRET=your-secret-here
# Control plane origin. Required when NODE_ENV is production.
# Example when you send records to the hosted console: https://console.spurvik.com
SPURVIK_BASE_URL=your-url-here
