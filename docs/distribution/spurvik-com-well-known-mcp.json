{
  "name": "Spurvik",
  "version": "1.0.1",
  "description": "Spurvik EU AI Act SDK (1.0.1) & MCP control plane (1.0.2, MIT). Designed to support Art. 50(1) notices and, for high-risk AI systems, Art. 12 logging and Art. 14 human oversight; responsibility stays with you.",
  "notice": "Spurvik EU AI Act SDK (1.0.1) & MCP control plane (1.0.2, MIT). Designed to support Art. 50(1) notices and, for high-risk AI systems, Art. 12 logging and Art. 14 human oversight; responsibility stays with you.",
  "transport": "streamable-http",
  "supportedProtocolVersions": ["2024-11-05", "2025-03-26", "2025-06-18"],
  "endpoints": [
    {
      "url": "https://console.spurvik.com/api/mcp",
      "transport": "streamable-http",
      "region": "fra1",
      "stateless": true,
      "protocolVersion": "2025-03-26",
      "supportedProtocolVersions": ["2024-11-05", "2025-03-26", "2025-06-18"],
      "tools": [
        "spurvik_setup_snippet",
        "spurvik_find_unwrapped_calls",
        "spurvik_explain_receipt",
        "spurvik_marking_hooks"
      ],
      "description": "Spurvik EU AI Act SDK (1.0.1) & MCP control plane (1.0.2, MIT). Designed to support Art. 50(1) notices and, for high-risk AI systems, Art. 12 logging and Art. 14 human oversight; responsibility stays with you."
    }
  ],
  "localStdio": {
    "packageName": "@spurvik/mcp",
    "version": "1.0.2",
    "npmPackage": "spurvik-mcp-server",
    "sdkNpmPackages": ["spurvik@1.0.1", "spurvik-sdk@1.0.1"],
    "license": "MIT",
    "command": "node",
    "args": ["packages/mcp/dist/index.js", "--root", "${workspaceFolder}"],
    "cursorConfigPath": ".cursor/mcp.json",
    "vscodeConfigPath": ".vscode/mcp.json",
    "claudeCodePluginConfigPath": "plugins/spurvik/.mcp.json",
    "claudeCodePluginArgs": ["${CLAUDE_PLUGIN_ROOT}/bin/spurvik-mcp.mjs", "--root", "${CLAUDE_PROJECT_DIR}"],
    "tools": [
      "spurvik_setup_snippet",
      "spurvik_find_unwrapped_calls",
      "spurvik_explain_receipt",
      "spurvik_marking_hooks"
    ]
  },
  "homepage": "https://spurvik.com",
  "repository": "https://github.com/spurvik/spurvik",
  "documentation": "https://spurvik.com/docs",
  "sandbox": "https://console.spurvik.com/sandbox?scan=https://your-app.com",
  "packages": {
    "sdk": "spurvik@1.0.1",
    "sdkAlias": "spurvik-sdk@1.0.1",
    "mcpServer": "spurvik-mcp-server@1.0.2"
  },
  "autoDiscovery": {
    "mcpRegistry": "https://github.com/spurvik/spurvik/blob/main/server.json",
    "smithery": "https://github.com/spurvik/spurvik/blob/main/smithery.yaml",
    "glama": "https://github.com/spurvik/spurvik/blob/main/glama.json"
  }
}
